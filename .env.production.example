# ── Helpdesk · .env de PRODUCCIÓN (soporte.aemegroup.com, Plesk) ──────────────
# Copia este archivo a «.env» en el nuevo subdominio y rellena lo marcado «CAMBIA».
# Pasos tras copiarlo (por SSH o el Laravel Toolkit de Plesk):
#   php artisan key:generate      # genera APP_KEY (hazlo con la BD aún VACÍA)
#   php artisan migrate --force   # crea todo el esquema
#   php artisan storage:link
#   php artisan optimize:clear
# El correo real y el WhatsApp NO van aquí: se configuran DENTRO de la app
# (Agentes → Configuración) y se guardan CIFRADOS en la BD con la APP_KEY.

APP_NAME="Soporte AEME"
APP_ENV=production
APP_KEY=                                   # CAMBIA: se rellena con `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://soporte.aemegroup.com

APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Logs (discretos en producción) ────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos — CREA UNA BD NUEVA en Plesk (NUNCA la de dev) ───────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIA_soporte_aeme
DB_USERNAME=CAMBIA_usuario
DB_PASSWORD=CAMBIA_contraseña

# ── Sesión / cola / caché / broadcast ─────────────────────────────────────────
# sync: los trabajos se ejecutan al momento (sin worker de colas).
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true                       # cifra el contenido de la sesión
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true                 # cookies solo por HTTPS
CACHE_STORE=database
FILESYSTEM_DISK=local
# log: sin websocket real; la app de agentes cae a sondeo y el portal ya sondea.
BROADCAST_CONNECTION=log

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo (respaldo de Laravel) ──────────────────────────────────────────────
# El buzón REAL (IMAP entrante + SMTP saliente) se configura en la app:
# Agentes → Configuración → «Buzón y envío». Esto es solo el remitente por defecto
# de Laravel (a `log` mientras no se toque).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="soporte@aemegroup.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Las credenciales (phone_number_id, WABA, token, app secret) y el token de
# verificación del webhook se configuran en la app (Campañas → Configuración) y
# se guardan en la BD. Aquí solo la versión del Graph API de Meta.
WA_GRAPH_VERSION=v21.0

# ── AWS / S3 (no se usa: adjuntos en disco local) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
