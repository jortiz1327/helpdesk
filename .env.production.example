# ── Helpdesk · .env de PRODUCCIÓN (servidor SSH propio, sin Plesk, MULTIHOST) ──
# Copia este archivo a «.env» en el servidor y rellena lo marcado «CAMBIA».
#
# Primera instalación (ver también deploy.sh para las ACTUALIZACIONES):
#   composer install --no-dev --optimize-autoloader
#   cp .env.production.example .env      # y rellenar
#   php artisan key:generate             # genera APP_KEY (BD aún vacía)
#   php artisan migrate --force
#   php artisan db:seed --force          # roles, categorías y admin (admin@aemegroup.com / admin1234)
#   php artisan storage:link
#   php artisan optimize
#   # cron (mueve correo/SLA/campañas): añade a crontab
#   #   * * * * * cd /var/www/helpdesk && php artisan schedule:run >> /dev/null 2>&1
#
# El correo REAL (IMAP/SMTP) y el WhatsApp NO van aquí: se configuran DENTRO de la
# app (Agentes/Campañas → Configuración) y se guardan CIFRADOS en la BD con la APP_KEY.

# ── MULTIHOST ──────────────────────────────────────────────────────────────────
# Un solo Laravel sirve estos 3 dominios (mismo document root public/ en Nginx,
# server_name con los tres, y un certbot para los tres):
#     soporte.aemegroup.com
#     soporte.etiquetaselectronicas.com
#     soporte.etiquetas.cloud
# La app bifurca sola (portal en la raíz, /agentes = app interna); no hay que tocar
# código. APP_URL es solo el dominio CANÓNICO (para enlaces absolutos de correos,
# adjuntos firmados, etc.). El webhook de WhatsApp apunta a UNO:
#     https://soporte.aemegroup.com/api/webhook.php
#
# ⚠️ DETRÁS DE CLOUDFLARE: para que Laravel vea HTTPS (y con SESSION_SECURE_COOKIE=true
# no se rompa el login), hay que CONFIAR EN EL PROXY. En bootstrap/app.php:
#     ->withMiddleware(function (Middleware $m) { $m->trustProxies(at: '*'); })
# (dímelo cuando montemos Cloudflare y lo dejo puesto.)

APP_NAME="Soporte AEME"
APP_ENV=production
APP_KEY=                                   # CAMBIA: `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://soporte.aemegroup.com      # dominio CANÓNICO (los otros 2 igual sirven)

APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logs (discretos en producción) ────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos (créala en el servidor con utf8mb4) ─────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIA_soporte
DB_USERNAME=CAMBIA_usuario
DB_PASSWORD=CAMBIA_contraseña

# ── Sesión / cola / caché / broadcast ─────────────────────────────────────────
QUEUE_CONNECTION=sync                       # sin worker: los trabajos van al momento
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null                         # null = cada dominio su propia cookie (multihost)
SESSION_SECURE_COOKIE=true                  # cookies solo por HTTPS (ver nota Cloudflare arriba)
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log                     # sin websocket real; agentes y portal sondean

# ── Correo (respaldo de Laravel; el buzón real se pone en la app) ─────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="soporte@aemegroup.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── WhatsApp (credenciales y verify token se configuran en la app) ────────────
WA_GRAPH_VERSION=v21.0

# ── AWS / S3 (no se usa: adjuntos en disco local) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
